# Dev image: Vite dev server with hot reload. Compose bind-mounts the source over
# /app and keeps node_modules in an anonymous volume, so deps come from the image
# while code changes come from the host.
FROM node:22-slim

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

EXPOSE 5173

# host:true (in vite.config) makes it listen on 0.0.0.0 so it's reachable from the host.
CMD ["npm", "run", "dev"]
