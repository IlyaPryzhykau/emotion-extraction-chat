# Copy to .env and fill in. Never commit the real .env.

# --- Database ---
# Local dev default matches docker-compose's postgres service.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/emotions

# --- LLM ---
OPENAI_API_KEY=sk-...
# Cheap/fast model for the conversation + live classifier.
CHAT_MODEL=gpt-5.4-mini
# Strong model for the one-shot final extraction.
EXTRACTION_MODEL=gpt-5.5
# Tip: run `python scripts/list_models.py` to see what your key can actually use.

# --- Auth ---
# Generate a strong value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SESSION_SECRET=change-me
